# Copy to .env.local. Never commit real credentials.
# Browser configuration (VITE_* is public in the generated JavaScript).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Enable after configuring Firebase Third-Party Auth and restrictive row policies.
VITE_SUPABASE_AUTH_MODE=firebase
VITE_GOOGLE_MAPS_API_KEY=
VITE_SENTRY_DSN=

# Gemini Live currently uses this key in the browser bundle. Use a restricted
# development key; do not treat it as a server-only secret in this architecture.
GEMINI_API_KEY=
# Legacy Gemini fallback (prefer GEMINI_API_KEY).
API_KEY=

# Optional server-side Opik tracing/evaluation.
OPIK_API_KEY=
OPIK_PROJECT_NAME=zenfit
OPIK_WORKSPACE=
OPIK_EXPERIMENT_NAME=
VITE_OPIK_PROJECT_NAME=zenfit

# Server only: never prefix these with VITE_ or send them to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
FIREBASE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/api/google/oauth/callback
GOOGLE_OAUTH_STATE_SECRET=
APP_BASE_URL=http://localhost:5173
APP_REDIRECT_AFTER_OAUTH=/
CRON_SECRET=
# Vercel supplies this automatically in production; omit the protocol.
VERCEL_PROJECT_PRODUCTION_URL=

# Local development only. Compose sets this to http://api:3001.
API_PROXY_TARGET=http://localhost:3001
