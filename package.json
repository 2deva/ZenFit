{
  "name": "zenfit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "lint": "npm run typecheck && npm run lint:eslint",
    "dev": "vite",
    "dev:api": "node --env-file-if-exists=.env.local --import tsx scripts/dev-api-server.ts",
    "eval:opik": "tsx scripts/run-opik-eval.ts",
    "eval:opik:threads": "tsx scripts/run-opik-eval-threads.ts",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "lint:eslint": "eslint . --max-warnings 0",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "@google/genai": "^1.37.0",
    "@supabase/supabase-js": "^2.91.0",
    "@vercel/analytics": "^2.0.1",
    "firebase": "^12.8.0",
    "lucide-react": "^0.562.0",
    "opik": "^1.10.1",
    "opik-gemini": "^1.10.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.6.2",
    "recharts": "^3.6.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.4.23",
    "dotenv": "^16.4.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "jsdom": "^24.1.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.19.2",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.2.0",
    "vitest": "^5.0.5"
  },
  "optionalDependencies": {
    "@sentry/react": "^8.55.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  }
}
